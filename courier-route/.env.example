# ---- חובה ----
# הכתובת שבה האפליקציה תיפתח. אם אין דומיין: <IP-של-השרת>.sslip.io (למשל 203.0.113.10.sslip.io)
DOMAIN=example.sslip.io
# סיסמת הכניסה לאפליקציה (של השליח)
APP_PASSWORD=change-me
# מפתח סודי אקראי (install.sh יוצר אוטומטית)
SECRET_KEY=change-me-to-random

# ---- איתור כתובות ----
# nominatim = חינם (OpenStreetMap). google = מדויק יותר בעברית, דורש מפתח API
GEOCODER=nominatim
GOOGLE_MAPS_API_KEY=
# מומלץ ב-Nominatim: כתובת מייל ליצירת קשר במקרה של בעיה (לא חובה)
NOMINATIM_EMAIL=

# ---- כללי ----
OCR_LANGS=heb+eng
OPTIMIZER_TIME_LIMIT=3
SESSION_DAYS=90
TZ=Asia/Jerusalem

# ---- הרחבות עתידיות ----
# none = לא נשלחות הודעות ללקוחות
NOTIFIER=none
